{
  "name": "niyamsetu-backend",
  "version": "0.1.0",
  "private": true,
  "description": "NiyamSetu backend: rule search, rulebook compiler, compliance check engine and review reports for MP Bhumi Vikas Rules 2012",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "eval": "node --env-file-if-exists=.env eval/run.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "mongoose": "^9.11.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "vitest": "^5.0.3"
  }
}
