# ==============================================================================
# NiyamSetu Backend Environment Configuration
# ==============================================================================
# Copy this file to `.env` in the backend folder:
# cp .env.example .env
#
# Note: NiyamSetu is designed to run in zero-config mode out of the box.
# If MongoDB or Anthropic keys are omitted, it gracefully falls back to:
# - In-memory store for rules, encoded rules, and applications
# - Deterministic BM25 + exact rulebook evidence mode for questions
# ==============================================================================

# Server Network Configuration
PORT=8000
CORS_ORIGIN=http://localhost:5173

# Database (MongoDB Atlas or Local MongoDB) - OPTIONAL
# Leave blank to run purely in memory without database
MONGODB_URI=
MONGODB_DB=niyamsetu

# AI / LLM Configuration (Anthropic Claude) - OPTIONAL
# If omitted, POST /api/questions operates in deterministic `evidence_only` mode
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219
LLM_TIMEOUT_MS=30000
LLM_MAX_TOKENS=1024

# Privacy & Logging
# Set to 'true' only for debugging question text in server console
LOG_QUESTION_TEXT=false

# Optional custom path to track-1 data directory (relative to backend/)
# Defaults to ../bhopal-impact-lab-2026-problem-statements-main/track-1-bhumi-vikas-sahayak
DATA_DIR=

# Benchmark runner URL (used by `npm run eval`)
EVAL_BASE_URL=http://localhost:8000
