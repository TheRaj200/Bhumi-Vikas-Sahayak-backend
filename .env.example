# Copy this file to .env and fill in values. Never commit .env.

PORT=8000

# anthropic | cerebras
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
# Model id you want to use (set by the team)
ANTHROPIC_MODEL=

CEREBRAS_API_KEY=
# Model id you want to use (set by the team)
CEREBRAS_MODEL=

LLM_TIMEOUT_MS=30000
